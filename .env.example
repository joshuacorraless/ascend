# Copia este archivo a `.env.local` (ignorado por git) y rellena los valores.
# Todo es opcional: la app funciona por completo para registro manual sin claves.
# Estas variables solo las lee el endpoint serverless (/api/analyze-label);
# no llevan prefijo VITE_, por lo que nunca se exponen al frontend.

# Proveedor de IA para el análisis de etiquetas: "google" | "anthropic".
# Vacío: se usa automáticamente el proveedor que tenga clave.
AI_PROVIDER=google

# Google Gemini (nivel gratuito disponible).
# Clave en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (de pago). Solo si AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Supabase (futuro, no necesario para el MVP; ver docs/SETUP.md).
# La anon key es pública por diseño.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
